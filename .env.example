# Public market stream only. Never expose exchange secrets to NEXT_PUBLIC variables.
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:8080/v1/stream
EXECUTION_MODE=PAPER
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_TERMINAL_PATH=D:\MT5IntelliTrade\terminal64.exe
# Enable only for a verified MT5 DEMO account. Real accounts remain rejected in code.
MT5_DEMO_ORDER_ROUTING=true
MT5_MAX_MARGIN_FRACTION=0.10
# Deribit TESTNET only. Create a separate testnet API key with trade:read_write.
# Never put production Deribit credentials in this application.
DERIBIT_TESTNET_CLIENT_ID=
DERIBIT_TESTNET_CLIENT_SECRET=
DERIBIT_TESTNET_MAX_OPTION_AMOUNT=10
# Autonomous worker execution is fail-closed. Leave false through monitoring validation.
DERIBIT_AUTOBOT_TESTNET_ROUTING=false
# Required before calendar/news systems can trigger event-driven Testnet entries.
CRYPTOV2_EVENT_WEBHOOK_SECRET=
# Public option snapshots default to five minutes and never use these credentials.
DERIBIT_OPTION_SNAPSHOT_INTERVAL_MS=300000
